{
  "$schema": "https://opencode.ai/config.json",
  // Model/provider deliberately left to the user/session.
  "shell": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
  "snapshots": true,
  "share": "disabled",
  "instructions": ["docs/harness.md"],
  // Keep a large verbatim recent tail; STATUS.md is the recovery point.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 40000 },
    "buffer": "20%"
  },
  "watcher": { "ignore": ["local/**", "build/**", "dist/**", "tmp/**"] },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" }
  ]
}
