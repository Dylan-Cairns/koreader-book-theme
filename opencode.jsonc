{
  "$schema": "https://opencode.ai/config.json",
  // Model/provider deliberately left to the user/session.
  "shell": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
  "snapshots": true,
  "share": "disabled",
  "instructions": ["docs/harness.md"],
  "watcher": { "ignore": ["local/**", "build/**", "dist/**", "tmp/**"] },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ]
}
